---
layout: base.njk
---
{# paper.njk — one publication. Every field is optional except the title:
   anything left blank in the CMS simply doesn't render. #}
<div class="wrap">
  <article class="article article--paper">

    <header class="paper-head">
      <a class="crumb" href="/publications/">← Publications</a>
      <h1>{{ (title or "Untitled") | chem | safe }}</h1>
      {% if authors %}<p class="paper-authors">{{ authors | chem | safe }}</p>{% endif %}
    </header>

    <div class="article-grid">

      <div class="article-main">
        {% if abstract %}
        <section class="abstract">
          <span class="mono">Abstract</span>
          <p>{{ abstract | chem | safe }}</p>
        </section>
        {% endif %}

        {% if problem or mattered or found or contribution or next %}
        <dl class="five">
          {% if problem %}<div><dt>The problem</dt><dd>{{ problem | chem | safe }}</dd></div>{% endif %}
          {% if mattered %}<div><dt>Why it mattered</dt><dd>{{ mattered | chem | safe }}</dd></div>{% endif %}
          {% if found %}<div><dt>What we found</dt><dd>{{ found | chem | safe }}</dd></div>{% endif %}
          {% if contribution %}<div><dt>My contribution</dt><dd>{{ contribution | chem | safe }}</dd></div>{% endif %}
          {% if next %}<div><dt>What's next</dt><dd>{{ next | chem | safe }}</dd></div>{% endif %}
        </dl>
        {% endif %}

        {% if content %}<div class="paper-body">{{ content | safe }}</div>{% endif %}

        {% if bibtex %}
        <div class="cite">
          <span class="mono">Cite this</span>
          <pre>{{ bibtex }}</pre>
        </div>
        {% endif %}
      </div>

      {# Side rail. Each row appears only if that field was filled in. #}
      <aside class="paper-meta">
        <dl>
          {% if journal %}
          <div><dt>Published in</dt><dd>{{ journal | chem | safe }}{% if year %}, {{ year }}{% endif %}</dd></div>
          {% elif year %}
          <div><dt>Year</dt><dd>{{ year }}</dd></div>
          {% endif %}

          {% if doi %}
          <div>
            <dt>DOI</dt>
            <dd><a class="doi" href="https://doi.org/{{ doi }}">{{ doi }}</a></dd>
          </div>
          {% endif %}

          {% if pdf %}
          <div><dt>Full text</dt><dd><a href="{{ pdf }}">Download PDF</a></dd></div>
          {% endif %}

          {% if data_url %}
          <div><dt>Data</dt><dd><a href="{{ data_url }}">Supporting data</a></dd></div>
          {% endif %}
        </dl>
      </aside>

    </div>
  </article>
</div>
