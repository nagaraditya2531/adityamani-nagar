---
layout: base.njk
---
{# post.njk — the page for one essay or note. #}
<div class="wrap">
  <article class="article">
    <div class="pagehead">
      <a class="crumb" href="/notebook/">← Notebook</a>
      <h1>{{ (title or "Untitled") | chem | safe }}</h1>
      <p class="article-meta">{{ date | monthYear }}</p>
    </div>
    {{ content | safe }}
  </article>
</div>
