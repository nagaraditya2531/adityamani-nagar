{# post.njk — the page for one essay or note. #}
---
layout: base.njk
---
<div class="wrap">
  <article class="article">
    <div class="pagehead">
      <a class="crumb" href="/writing/">← Writing</a>
      <h1>{{ title }}</h1>
      <p class="article-meta">{{ date | monthYear }}</p>
    </div>
    {{ content | safe }}
  </article>
</div>
