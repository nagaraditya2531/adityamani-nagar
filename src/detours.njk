---
layout: base.njk
permalink: /detours/
title: Detours
description: Day trips, walks and small moments.
---
<div class="wrap">
  <div class="pagehead rise">
    <span class="mono">{{ pagetext.detours.eyebrow or "Detours" }}</span>
    <h1>{{ pagetext.detours.heading | chem | safe }}</h1>
    {% if pagetext.detours.intro %}<p>{{ pagetext.detours.intro }}</p>{% endif %}
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="places rise">
      {% for item in collections.detours %}
      <a class="place" href="{{ item.url }}">
        {% if item.data.photo %}<img src="{{ item.data.photo }}" alt="{{ item.data.title or "Untitled" }}, {{ item.data.where }} — {{ site.name }}" loading="lazy" decoding="async">{% endif %}
        <div class="place-body">
          <span class="place-when">{{ item.data.date | monthYear }} · {{ item.data.where }}</span>
          <h3>{{ (item.data.title or "Untitled") | chem | safe }}</h3>
          <p>{{ item.data.summary }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
