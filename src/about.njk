---
layout: base.njk
permalink: /about/
title: About
description: About me, and how to get in touch.
---
{% from "icons.njk" import icon %}
<div class="wrap">
  <div class="pagehead rise">
    <span class="mono">{{ pagetext.about.eyebrow or "About" }}</span>
    <h1>{{ about.heading }}</h1>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="about rise">
      <div>
        {% for para in about.paragraphs %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
      <div>
        {# Contact sits at the top of the right column, visible without scrolling. #}
        <div class="contact-card">
          <span class="mono">{{ pagetext.about.contact_label or "Get in touch" }}</span>
          <a class="email" href="mailto:{{ site.email }}">{{ site.email }}</a>
          <ul class="iconrow">
            {% for l in site.links %}
            {% if l.url and l.url != "#" %}
            <li><a href="{{ l.url }}" aria-label="{{ l.label }}" title="{{ l.label }}">{{ icon(l.label) }}</a></li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>

        {% if site.facts and site.facts.length %}
        <ul class="facts">
          {% for f in site.facts %}
          <li><span class="k">{{ f.key }}</span><span class="v">{{ f.value }}</span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>
  </div>
</section>
