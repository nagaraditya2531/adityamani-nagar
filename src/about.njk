---
layout: base.njk
permalink: /about/
title: About
description: About me, and how to get in touch.
---
<div class="wrap">
  <div class="pagehead rise">
    <span class="mono">About</span>
    <h1>{{ about.heading }}</h1>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="about rise">
      <div>
        {% for para in about.paragraphs %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
      {% if site.facts and site.facts.length %}
      <ul class="facts">
        {% for f in site.facts %}
        <li><span class="k">{{ f.key }}</span><span class="v">{{ f.value }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>

<section class="section" id="contact">
  <div class="wrap">
    <div class="section-head rise"><h2>{{ about.contact_heading }}</h2></div>
    <div class="rise">
      <a class="mailto" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <div class="elsewhere">
        {% for l in site.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
      </div>
    </div>
  </div>
</section>
