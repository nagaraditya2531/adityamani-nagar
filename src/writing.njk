---
layout: base.njk
permalink: /writing/
title: Writing
description: Essays and notes.
---
<div class="wrap">
  <div class="pagehead rise">
    <span class="mono">Writing</span>
    <h1>Thinking out loud, in public.</h1>
    <p>Less polished than the papers, and often more useful.</p>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="rise">
      {% for group in collections.writing | byYear %}
      <section class="year">
        <div class="year-inner">
          <h3 class="year-mark">{{ group.year }}</h3>
          <div>
            {% for item in group.items %}
            <article class="item">
              <a class="item-link{% if item.data.image %} has-thumb{% endif %}" href="{{ item.url }}">
                {% if item.data.image %}<img class="item-thumb" src="{{ item.data.image }}" alt="">{% endif %}
                <span class="item-type">Essay</span>
                <span class="item-title">{{ item.data.title }}</span>
                <span class="item-meta">{{ item.data.summary }}</span>
                <span class="item-arrow" aria-hidden="true">→</span>
              </a>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>
      {% endfor %}
    </div>
  </div>
</section>
