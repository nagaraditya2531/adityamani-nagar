---
layout: base.njk
permalink: /places/
title: Places
description: Conferences, and the days either side of them.
---
<div class="wrap">
  <div class="pagehead rise">
    <span class="mono">Places</span>
    <h1>Conferences, and the days either side of them.</h1>
    <p>A dozen photographs and a paragraph each, not eight hundred.</p>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="places rise">
      {% for item in collections.places %}
      <a class="place" href="{{ item.url }}">
        {% if item.data.photo %}<img src="{{ item.data.photo }}" alt="">{% endif %}
        <div class="place-body">
          <span class="place-when">{{ item.data.date | monthYear }} · {{ item.data.where }}</span>
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.summary }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
