---
layout: base.njk
permalink: /
description: Researcher and writer. Research, publications, essays, reading and places.
---
<section class="hero">
  <div class="wrap">
    <div class="intro">
      <div>
        <span class="hero-eyebrow mono rise">{{ pagetext.home.eyebrow or (site.tagline + " · " + site.location) }}</span>
        <h1 class="rise">{{ pagetext.home.heading | chem | safe }}</h1>
        <p class="hero-lede rise">{{ pagetext.home.intro | chem | safe }}</p>
      </div>
      <figure class="portrait rise">
        <img src="{{ site.portrait }}" alt="{{ site.name }}, {{ site.jobTitle }} at {{ site.affiliation }}" fetchpriority="high">
      </figure>
    </div>

    {# --- Now block. Hidden entirely if show is false or there are no lines. --- #}
    {% if now.show and now.lines and now.lines.length %}
    <div class="now rise">
      <div class="now-head">
        <span class="mono">Now</span>
        {% if now.updated %}<span class="mono">Updated {{ now.updated }}</span>{% endif %}
      </div>
      <ul class="now-list">
        {% for line in now.lines %}
          {% if line.text %}
          <li><span class="k">{{ line.label }}</span><span>{{ line.text }}</span></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

{# --- One mixed feed: work and life in the same list --- #}
<section class="section">
  <div class="wrap">
    <div class="section-head rise">
      <h2>{{ pagetext.home.recent_heading or 'Recently' }}</h2>
      <a class="more" href="/publications/">{{ pagetext.home.recent_link or "Full record →" }}</a>
    </div>
    <div class="feed rise">
      {% for item in collections.everything | limit(5) %}
      {# Reading entries have no page of their own, so they point at the list. #}
      {% set target = item.url if item.url else '/notebook/' %}
      <article class="item" data-kind="{% if 'reading' in item.filePathStem or 'detours' in item.filePathStem %}life{% else %}work{% endif %}">
        <a class="item-link{% if item.data.image or item.data.cover or item.data.photo %} has-thumb{% endif %}" href="{{ target }}">
          {% set thumb = item.data.image or item.data.cover or item.data.photo %}
          {% if thumb %}<img class="item-thumb" src="{{ thumb }}" alt="{{ item.data.title or "Untitled" }} — {{ site.name }}" loading="lazy" decoding="async">{% endif %}
          <span class="item-type">{% if 'papers' in item.filePathStem %}Paper{% elif 'writing' in item.filePathStem %}Essay{% elif 'conferences' in item.filePathStem %}Conference{% elif 'detours' in item.filePathStem %}Detour{% else %}Reading{% endif %}</span>
          <span class="item-title">{{ (item.data.title or "Untitled") | chem | safe }}</span>
          <span class="item-meta">{{ item.data.journal or item.data.where or item.data.author or "" }} · {{ item.data.date | monthYear }}</span>
          <span class="item-arrow" aria-hidden="true">→</span>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# --- Open questions, from src/_data/questions.yaml --- #}
<section class="section">
  <div class="wrap">
    <div class="section-head rise">
      <h2>{{ pagetext.home.questions_heading or 'Open questions' }}</h2>
      <a class="more" href="/research/#questions">{{ pagetext.home.questions_link or "All questions →" }}</a>
    </div>
    <ul class="qlist rise">
      {% for q in questions.questions | limit(2) %}
      <li>
        <span class="q">{{ q.text }}</span>
        <span class="q-meta"><span class="pill" data-state="{{ q.state }}">{% if q.state == 'open' %}Open{% elif q.state == 'active' %}In progress{% else %}Closed{% endif %}</span></span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head rise"><h2>{{ pagetext.home.personal_heading or 'Away from the bench' }}</h2></div>
    <div class="rise" style="max-width:56ch">
      <p>{{ pagetext.home.personal_text }}</p>
      <div class="elsewhere">
        <a href="/notebook/">What I'm reading</a>
        <a href="/detours/">Where I've been</a>
        <a href="/about/">Get in touch</a>
      </div>
    </div>
  </div>
</section>
