---
layout: base.njk
permalink: /
description: Researcher and writer. Research, publications, essays, reading and places.
---
<section class="hero">
  <div class="wrap">
    <div class="intro">
      <div>
        <span class="hero-eyebrow mono rise">{{ site.tagline }} · {{ site.location }}</span>
        <h1 class="rise">I'm {{ site.name.split(" ")[0] }}. I ask questions for a living, and write down the ones I can't answer yet.</h1>
        <p class="hero-lede rise">
          Right now that means chemistry — <strong>separation, coordination, the behaviour of
          things in solution</strong>. It may not always. What doesn't change is the habit of
          keeping a record.
        </p>
      </div>
      <figure class="portrait rise">
        <img src="{{ site.portrait }}" alt="{{ site.name }}">
      </figure>
    </div>

    {# --- Now block. Hidden entirely if show is false or there are no lines. --- #}
    {% if now.show and now.lines and now.lines.length %}
    <div class="now rise">
      <div class="now-head">
        <span class="mono">Now</span>
        {% if now.updated %}<span class="mono">Updated {{ now.updated }}</span>{% endif %}
      </div>
      <ul class="now-list">
        {% for line in now.lines %}
          {% if line.text %}
          <li><span class="k">{{ line.label }}</span><span>{{ line.text }}</span></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

{# --- One mixed feed: work and life in the same list --- #}
<section class="section">
  <div class="wrap">
    <div class="section-head rise">
      <h2>Recently</h2>
      <a class="more" href="/publications/">Full record →</a>
    </div>
    <div class="feed rise">
      {% for item in collections.everything | limit(5) %}
      {# Reading entries have no page of their own, so they point at the list. #}
      {% set target = item.url if item.url else '/reading/' %}
      <article class="item" data-kind="{% if 'reading' in item.filePathStem or 'places' in item.filePathStem %}life{% else %}work{% endif %}">
        <a class="item-link" href="{{ target }}">
          <span class="item-type">{% if 'papers' in item.filePathStem %}Paper{% elif 'writing' in item.filePathStem %}Essay{% elif 'places' in item.filePathStem %}Places{% else %}Reading{% endif %}</span>
          <span class="item-title">{{ item.data.title }}</span>
          <span class="item-meta">{{ item.data.journal or item.data.where or item.data.author or "" }} · {{ item.data.date | monthYear }}</span>
          <span class="item-arrow" aria-hidden="true">→</span>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# --- Open questions, from src/_data/questions.yaml --- #}
<section class="section">
  <div class="wrap">
    <div class="section-head rise">
      <h2>Open questions</h2>
      <a class="more" href="/research/#questions">All questions →</a>
    </div>
    <ul class="qlist rise">
      {% for q in questions.questions | limit(2) %}
      <li>
        <span class="q">{{ q.text }}</span>
        <span class="q-meta"><span class="pill" data-state="{{ q.state }}">{% if q.state == 'open' %}Open{% elif q.state == 'active' %}In progress{% else %}Closed{% endif %}</span></span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head rise"><h2>Away from the bench</h2></div>
    <div class="rise" style="max-width:56ch">
      <p>Three or four sentences about what you do when you're not working. Be specific and
         slightly odd — the reader has met a hundred people who "enjoy travelling and reading."</p>
      <div class="elsewhere">
        <a href="/reading/">What I'm reading</a>
        <a href="/places/">Where I've been</a>
        <a href="/about/#contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>
